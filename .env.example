# ============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Never commit real API keys or secrets to version control.
# ============================================================================

# Contact Form Endpoint (Optional)
# Configure a form submission endpoint (e.g., Formspree, Basin, or your custom Express API URL)
# Example: https://formspree.io/f/your_form_id
# Leave empty to keep the form in interactive client-side preview/mailto mode.
VITE_CONTACT_ENDPOINT=

# Personal Contact & Social Links (Optional overrides for src/data/portfolioData.js)
VITE_CONTACT_EMAIL=hello.priyanshudhaka@example.com
VITE_GITHUB_URL=https://github.com/your-username
VITE_LINKEDIN_URL=https://linkedin.com/in/your-profile
VITE_X_URL=https://x.com/your-handle

# Resume File Path
VITE_RESUME_URL=/resume/Priyanshu_Dhaka_Resume_Placeholder.pdf

# Site Canonical URL (for SEO & Open Graph)
VITE_SITE_URL=https://priyanshudhaka.example.com
